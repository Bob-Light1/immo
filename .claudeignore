# .claudeignore — keeps bulky, irrelevant material out of Claude Code's context
# (generated files, dependencies, binaries). Source code, the Prisma schema and
# the design PDF stay reachable.

# Dependencies (regenerated by npm install)
node_modules/

# Build outputs and caches (regenerable)
.next/
.turbo/
dist/
build/
out/
coverage/
*.tsbuildinfo

# Lockfile (445 KB, never worth reading — package.json is enough)
package-lock.json

# HTML duplicate of the design document (the PDF stays readable)
CampusGest_Conception_v2.html

# Binaries / generated assets
apps/web/public/icons/
apps/web/app/favicon.ico

# Git internals
.git/
