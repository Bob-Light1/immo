# ─────────────────────────────────────────────────────────────────────────────
# MODÈLE d'environnement de PRODUCTION (Docker Compose).
# Copier vers `.env` sur le serveur puis remplacer TOUTES les valeurs __...__.
#   cp .env.production.example .env && nano .env
# Ce fichier ne doit JAMAIS contenir de vrais secrets ni être commité rempli.
#
# Générer un secret :  openssl rand -hex 32
# Générer les clés VAPID :  npx web-push generate-vapid-keys
# ─────────────────────────────────────────────────────────────────────────────

# ── Domaine public (utilisé par Caddy pour le certificat TLS) ───────────────
APP_DOMAIN=campus.votre-domaine.cm

# ── Base de données ─────────────────────────────────────────────────────────
# POSTGRES_PASSWORD sert à Compose (init du conteneur) ET doit être répété
# LITTÉRALEMENT dans DATABASE_URL (les env_file n'interpolent pas les variables).
POSTGRES_PASSWORD=__mot_de_passe_postgres_fort__
DATABASE_URL=postgresql://campusgest:__mot_de_passe_postgres_fort__@postgres:5432/campusgest
REDIS_URL=redis://redis:6379

# ── Auth : secrets uniques et longs (openssl rand -hex 32) ──────────────────
JWT_SECRET=__64_caracteres_aleatoires__
JWT_REFRESH_SECRET=__autre_64_caracteres_aleatoires__
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ── URL publique réelle (figée dans le bundle client au build) ──────────────
NEXT_PUBLIC_APP_URL=https://campus.votre-domaine.cm
NODE_ENV=production

# ── Web Push (VAPID) — paire STABLE, à sauvegarder ──────────────────────────
VAPID_PUBLIC_KEY=__cle_publique_vapid__
VAPID_PRIVATE_KEY=__cle_privee_vapid__
VAPID_SUBJECT=mailto:admin@votre-domaine.cm

# ── Stockage objet (MinIO interne au réseau Docker) ─────────────────────────
STORAGE_DRIVER=s3
S3_ENDPOINT=minio
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=campusgest
S3_SECRET_KEY=__secret_minio_fort__
S3_BUCKET=campusgest
S3_REGION=us-east-1
# URL PUBLIQUE servie par Caddy (/storage). Sans / final. Origine autorisée par la CSP.
S3_PUBLIC_URL=https://campus.votre-domaine.cm/storage/campusgest

# ── Cloudinary (alternative SaaS, inactif tant que STORAGE_DRIVER=s3) ───────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (SMTP) — optionnel (P1 : livraison par push uniquement) ───────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── SMS (canal désactivé) ───────────────────────────────────────────────────
SMS_PROVIDER=nexah
SMS_API_KEY=
SMS_SENDER_ID=CAMPUSGEST

# ── Mobile Money (saisie manuelle Admin en P1) ──────────────────────────────
MOMO_OM_API_KEY=
MOMO_MTN_API_KEY=

# ── Seed admin : mot de passe temporaire, imposé au changement 1re connexion ─
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=__mot_de_passe_temporaire_solide__
