# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION environment TEMPLATE (Docker Compose).
# Copy it to `.env` on the server then replace EVERY __...__ value.
#   cp .env.production.example .env && nano .env
# This file must NEVER hold real secrets, nor be committed filled in.
#
# Generate a secret:  openssl rand -hex 32
# Generate the VAPID keys:  npx web-push generate-vapid-keys
# ─────────────────────────────────────────────────────────────────────────────

# ── Public domain (used by Caddy for the TLS certificate) ───────────────────
APP_DOMAIN=campus.votre-domaine.cm

# ── Residence time zone ─────────────────────────────────────────────────────
# Month keys (YYYY-MM) and the workers' cron schedules are read from the LOCAL
# components of the containers' clock, which is UTC unless set here. Setting the
# host's zone (timedatectl) does not reach inside a container.
TZ=Africa/Douala

# ── Database ────────────────────────────────────────────────────────────────
# POSTGRES_PASSWORD is used by Compose (container init) AND must be repeated
# LITERALLY in DATABASE_URL (env_file does not interpolate variables).
POSTGRES_PASSWORD=__mot_de_passe_postgres_fort__
DATABASE_URL=postgresql://campusgest:__mot_de_passe_postgres_fort__@postgres:5432/campusgest
REDIS_URL=redis://redis:6379

# ── Auth: unique, long secrets (openssl rand -hex 32) ───────────────────────
JWT_SECRET=__64_caracteres_aleatoires__
JWT_REFRESH_SECRET=__autre_64_caracteres_aleatoires__
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ── Real public URL (frozen into the client bundle at build) ────────────────
NEXT_PUBLIC_APP_URL=https://campus.votre-domaine.cm
NODE_ENV=production

# ── Web Push (VAPID) — STABLE pair, keep a backup ───────────────────────────
VAPID_PUBLIC_KEY=__cle_publique_vapid__
VAPID_PRIVATE_KEY=__cle_privee_vapid__
VAPID_SUBJECT=mailto:admin@votre-domaine.cm

# ── Object storage (MinIO, internal to the Docker network) ──────────────────
STORAGE_DRIVER=s3
S3_ENDPOINT=minio
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=campusgest
S3_SECRET_KEY=__secret_minio_fort__
S3_BUCKET=campusgest
S3_REGION=us-east-1

# Optional. Objects are served by Caddy under /storage on this very domain, so
# the CSP's `'self'` already covers them. Set this only to keep allowing the
# origin of assets recorded as absolute URLs before paths went relative.
S3_PUBLIC_URL=

# ── Cloudinary (SaaS alternative, inactive while STORAGE_DRIVER=s3) ─────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (SMTP) — optional (P1: push delivery only) ────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── SMS (channel disabled) ──────────────────────────────────────────────────
SMS_PROVIDER=nexah
SMS_API_KEY=
SMS_SENDER_ID=CAMPUSGEST

# ── Mobile Money (manual Admin entry in P1) ─────────────────────────────────
MOMO_OM_API_KEY=
MOMO_MTN_API_KEY=

# ── Admin seed: temporary password, must be changed on first login ───────────
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=__mot_de_passe_temporaire_solide__
