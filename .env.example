# ─── Base de données ─────────────────────────────────────────────
DATABASE_URL=postgresql://campusgest:campusgest@localhost:5433/campusgest
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────────────
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ─── App ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Web Push (VAPID) ────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@votre-domaine.cm

# ─── Stockage fichiers (S3 / MinIO self-host) ────────────────────
# Backend S3-compatible : MinIO en dev (docker compose), tout fournisseur
# S3 en prod. Le bucket doit autoriser la lecture anonyme (download).
STORAGE_DRIVER=s3
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=campusgest
S3_SECRET_KEY=campusgest-secret
S3_BUCKET=campusgest
S3_REGION=us-east-1
# URL publique de base servant les objets (sans / final). En prod, pointer
# vers le CDN/reverse-proxy devant MinIO. En dev : http://localhost:9000/campusgest
S3_PUBLIC_URL=http://localhost:9000/campusgest

# ─── Stockage fichiers (Cloudinary — alternative SaaS, non actif) ─
# Pour basculer : STORAGE_DRIVER=cloudinary + renseigner ces clés.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email (SMTP) ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── SMS (passerelle locale) ─────────────────────────────────────
SMS_PROVIDER=nexah
SMS_API_KEY=
SMS_SENDER_ID=CAMPUSGEST

# ─── Mobile Money (phase 2 - optionnel) ──────────────────────────
MOMO_OM_API_KEY=
MOMO_MTN_API_KEY=

# ─── Seed admin (mot de passe temporaire, changé au 1er login) ───
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin1234
