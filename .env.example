# ─── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql://campusgest:campusgest@localhost:5433/campusgest
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────────────
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ─── App ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Web Push (VAPID) ────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@votre-domaine.cm

# ─── File storage (S3 / MinIO self-hosted) ───────────────────────
# S3-compatible backend: MinIO in dev (docker compose), any S3 provider in
# production. The bucket must allow anonymous read (download).
# Objects are served by the application's own origin, under /storage/<bucket>/
# — in production the reverse proxy answers that prefix straight from the
# bucket, in dev the Next route handler does. Nothing here ends up in the
# database, so a change of domain never invalidates a stored file.
STORAGE_DRIVER=s3
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=campusgest
S3_SECRET_KEY=campusgest-secret
S3_BUCKET=campusgest
S3_REGION=us-east-1
# Optional, and only for rows written before object paths went relative: an
# absolute base URL whose origin the CSP keeps allowing (img-src/connect-src).
# Leave empty on a fresh install.
S3_PUBLIC_URL=

# ─── File storage (Cloudinary — SaaS alternative, inactive) ───────
# To switch: STORAGE_DRIVER=cloudinary + fill in these keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email (SMTP) ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── SMS (local gateway) ─────────────────────────────────────────
SMS_PROVIDER=nexah
SMS_API_KEY=
SMS_SENDER_ID=CAMPUSGEST

# ─── Mobile Money (phase 2 - optional) ───────────────────────────
MOMO_OM_API_KEY=
MOMO_MTN_API_KEY=

# ─── Admin seed (temporary password, changed on first login) ─────
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin1234
