# ─── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql://campusgest:campusgest@localhost:5433/campusgest
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────────────
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ─── App ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Web Push (VAPID) ────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@votre-domaine.cm

# ─── File storage (S3 / MinIO self-hosted) ───────────────────────
# S3-compatible backend: MinIO in dev (docker compose), any S3 provider in
# production. The bucket must allow anonymous read (download).
STORAGE_DRIVER=s3
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=campusgest
S3_SECRET_KEY=campusgest-secret
S3_BUCKET=campusgest
S3_REGION=us-east-1
# Public base URL serving the objects (no trailing /). In production, point it
# at the CDN/reverse proxy in front of MinIO. In dev: http://localhost:9000/campusgest
S3_PUBLIC_URL=http://localhost:9000/campusgest

# ─── File storage (Cloudinary — SaaS alternative, inactive) ───────
# To switch: STORAGE_DRIVER=cloudinary + fill in these keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email (SMTP) ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── SMS (local gateway) ─────────────────────────────────────────
SMS_PROVIDER=nexah
SMS_API_KEY=
SMS_SENDER_ID=CAMPUSGEST

# ─── Mobile Money (phase 2 - optional) ───────────────────────────
MOMO_OM_API_KEY=
MOMO_MTN_API_KEY=

# ─── Admin seed (temporary password, changed on first login) ─────
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin1234
