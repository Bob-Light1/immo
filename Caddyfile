# ─────────────────────────────────────────────────────────────────────────────
# CampusGest reverse proxy — automatic TLS (Let's Encrypt).
# The domain comes from the APP_DOMAIN variable (docker-compose.prod.yml).
# ─────────────────────────────────────────────────────────────────────────────

{$APP_DOMAIN} {
	encode gzip

	# Object storage (images, documents, receipts) → MinIO.
	# handle_path strips the /storage prefix: /storage/campusgest/<key>
	# becomes /campusgest/<key> on MinIO. Must match S3_PUBLIC_URL.
	handle_path /storage/* {
		reverse_proxy minio:9000
	}

	# Next.js application (pages, API, notification SSE stream).
	handle {
		reverse_proxy web:3000 {
			# Disable buffering for SSE streaming (GET /api/notifications/stream).
			flush_interval -1
		}
	}

	# Access logging (automatic rotation).
	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
