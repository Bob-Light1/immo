# Docker build context — send only what the daemon needs.
# Regenerable or heavy:
node_modules
**/node_modules
.next
apps/web/.next
.turbo
**/.turbo
dist
build
out
coverage
*.tsbuildinfo

# Secrets — NEVER copy them into an image (injected at runtime via env_file).
.env
.env.*
!.env.example
!.env.production.example

# Git & misc
.git
.github
*.log
.DS_Store
.vscode
.idea

# Large documents not needed at runtime
CampusGest_Conception_v2.pdf
CampusGest_Conception_v2.html
docs
